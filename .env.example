# Porta: a Railway injeta PORT automaticamente.
PORT=3000
# Pasta de dados. Na Railway, monte um volume em /data e use DATA_DIR=/data.
DATA_DIR=./.data
# Códigos de acesso por nível. ACCESS_CODE (ou ACCESS_CODE_GERENCIAL) = gerencial: tudo.
# ACCESS_CODE_OPERADOR = operador de compra de grãos: pedidos, produtores, cotações e ofertas (sem parâmetros e sem escrita em armazenagem).
# ACCESS_CODE_ARMAZEM = encarregado de armazém: unidades, estoque, qualidade e recebimentos (leitura no resto).
# Aceitam vários códigos separados por vírgula. Todos vazios = acesso aberto (somente para teste local).
ACCESS_CODE=
ACCESS_CODE_OPERADOR=
ACCESS_CODE_ARMAZEM=
